<?xml version="1.0" encoding="utf-8"?>
<!-- Pairing keys and paired devices must never be backed up or transferred. -->
<data-extraction-rules>
    <cloud-backup><exclude domain="root" /><exclude domain="file" /><exclude domain="sharedpref" /></cloud-backup>
    <device-transfer><exclude domain="root" /><exclude domain="file" /><exclude domain="sharedpref" /></device-transfer>
</data-extraction-rules>
